{
    "format_version": "1.21.110",
    "minecraft:biome": {
        "description": {
            "identifier": "extrabiomes:tallow_hollows"
        },
        "components": {
            "minecraft:climate": {
                "temperature": 0.7,
                "downfall": 0.3
            },
            "minecraft:overworld_height": {
                "noise_type": "default"
            },
            "minecraft:surface_builder": {
                "builder": {
                    "type": "minecraft:overworld",
                    "sea_floor_depth": 7,
                    "sea_floor_material": "minecraft:gravel",
                    "foundation_material": "minecraft:stone",
                    "mid_material": "minecraft:dirt",
                    "top_material": "minecraft:grass_block",
                    "sea_material": "minecraft:water"
                }
            },
            "minecraft:replace_biomes": {
                "replacements": [
                    {
                        "dimension": "minecraft:overworld",
                        "targets": ["minecraft:dripstone_caves"],
                        "amount": 0.33,
                        "noise_frequency_scale": 0.2
                    }
                ]
            },
            // No dripstone_caves tag: the wax drips replace vanilla's pointed dripstone here.
            "minecraft:tags": {
                "tags": ["caves", "monster", "overworld", "tallow_hollows"]
            }
        }
    }
}
