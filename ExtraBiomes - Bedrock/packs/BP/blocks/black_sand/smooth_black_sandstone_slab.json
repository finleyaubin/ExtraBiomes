{
  "format_version": "1.20.100",
  "minecraft:block": {
    "description": {
      "identifier": "extrabiomes:smooth_black_sandstone_slab",
      "menu_category": {
        "category": "construction",
        "group": "itemGroup.name.slab"
      },
      "states": {
        "extrabiomes:is_double": [
          false,
          true
        ]
      },
      "traits": {
        "minecraft:placement_position": {
          "enabled_states": [
            "minecraft:vertical_half"
          ]
        }
      }
    },
    "components": {
      "minecraft:map_color": "#262422",
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.8
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "extrabiomes_black_sandstone_smooth",
          "render_method": "opaque"
        }
      },
			"minecraft:liquid_detection": {
				"detection_rules": [
					{
						"liquid_type": "water",
						"can_contain_liquid": true, 
						"on_liquid_touches": "blocking"
					}
				]
			},
      "tag:minecraft:is_pickaxe_item_destructible": {}
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:vertical_half') == 'bottom'  && query.block_state('extrabiomes:is_double') == false ",
        "components": {
          "minecraft:geometry": "geometry.slab_down",
          "minecraft:light_dampening": 0,
          "minecraft:collision_box": {
            "origin": [
              -8,
              0,
              -8
            ],
            "size": [
              16,
              8,
              16
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -8,
              0,
              -8
            ],
            "size": [
              16,
              8,
              16
            ]
          },
          "extrabiomes:slabber_component": {}
        }
      },
      {
        "condition": "q.block_state('minecraft:vertical_half') == 'top' && query.block_state('extrabiomes:is_double') == false",
        "components": {
          "minecraft:geometry": "geometry.slab_up",
          "minecraft:light_dampening": 0,
          "minecraft:collision_box": {
            "origin": [
              -8,
              8,
              -8
            ],
            "size": [
              16,
              8,
              16
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -8,
              8,
              -8
            ],
            "size": [
              16,
              8,
              16
            ]
          },
          "extrabiomes:slabber_component": {}
        }
      },
      {
        "condition": "query.block_state('extrabiomes:is_double') == true",
        "components": {
          "minecraft:geometry": "minecraft:geometry.full_block",
          "minecraft:loot": "loot_tables/blocks/smooth_black_sandstone_slab.json",
          "minecraft:light_dampening": 15,
                    "minecraft:collision_box": {
            "origin": [
              -8,
              0,
              -8
            ],
            "size": [
              16,
              16,
              16
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -8,
              0,
              -8
            ],
            "size": [
              16,
              16,
              16
            ]
          }
        }
      }
      
    ]
  }
}