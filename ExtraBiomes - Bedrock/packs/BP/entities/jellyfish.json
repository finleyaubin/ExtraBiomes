{
    "format_version": "1.17.100",
    "minecraft:entity": {
        "description": {
            "identifier": "extrabiomes:jellyfish",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "component_groups": {
            "jellyfish_purple": {
                "minecraft:variant": {
                    "value": 1
                }
            },
            "jellyfish_pink": {
                "minecraft:variant": {
                    "value": 2
                }
            },
            "jellyfish_out_of_water_hitbox": {
                "minecraft:collision_box": {
                    "width": 0.8,
                    "height": 0.1
                }
            },
            "instant_despawn": {
                "minecraft:instant_despawn": {}
            },
            // Milking is gated by a component group rather than a plain interaction, because
            // Bedrock's interact component has no per-interaction cooldown: the jellyfish is
            // re-added once the "milk_cooldown" timer below runs out. Both interactions live in
            // this group so replacing it doesn't drop the jellyfishing-net catch.
            "milk_available": {
                "minecraft:interact": {
                    "interactions": [
                        {
                            "on_interact": {
                                "filters": {
                                    "all_of": [
                                        {
                                            "test": "is_family",
                                            "subject": "other",
                                            "value": "player"
                                        },
                                        {
                                            "test": "has_equipment",
                                            "domain": "hand",
                                            "subject": "other",
                                            "value": "glass_bottle"
                                        }
                                    ]
                                },
                                "event": "extrabiomes:begin_milk_cooldown",
                                "target": "self"
                            },
                            "use_item": true,
                            "transform_to_item": "extrabiomes:jellyfish_jam_bottle",
                            "play_sounds": "milk",
                            "interact_text": "action.interact.milk"
                        },
                        {
                            "on_interact": {
                                "filters": {
                                    "all_of": [
                                        {
                                            "test": "is_family",
                                            "subject": "other",
                                            "value": "player"
                                        },
                                        {
                                            "test": "has_equipment",
                                            "domain": "hand",
                                            "subject": "other",
                                            "value": "extrabiomes:jellyfishing_net_empty"
                                        }
                                    ]
                                },
                                "event": "extrabiomes:instant_despawn",
                                "target": "self"
                            },
                            "use_item": true,
                            "transform_to_item": "extrabiomes:jellyfishing_net_full",
                            "interact_text": "catch",
                            "swing": true
                        }
                    ]
                }
            },
            "milk_cooldown": {
                "minecraft:interact": {
                    "interactions": [
                        {
                            "on_interact": {
                                "filters": {
                                    "all_of": [
                                        {
                                            "test": "is_family",
                                            "subject": "other",
                                            "value": "player"
                                        },
                                        {
                                            "test": "has_equipment",
                                            "domain": "hand",
                                            "subject": "other",
                                            "value": "extrabiomes:jellyfishing_net_empty"
                                        }
                                    ]
                                },
                                "event": "extrabiomes:instant_despawn",
                                "target": "self"
                            },
                            "use_item": true,
                            "transform_to_item": "extrabiomes:jellyfishing_net_full",
                            "interact_text": "catch",
                            "swing": true
                        }
                    ]
                },
                "minecraft:timer": {
                    "looping": false,
                    "time": 30,
                    "time_down_event": {
                        "event": "extrabiomes:end_milk_cooldown",
                        "target": "self"
                    }
                }
            },
            "projectile": {
                "minecraft:projectile": {
                    "anchor": 1,
                    "power": 3,
                    "gravity": 0,
                    "angle_offset": 0,
                    "offset": [0, -0.1, 0]
                },
                // Kept inside the group rather than in the base components so it can't be
                // overwritten by the milk cooldown's own timer (an entity only holds one
                // minecraft:timer at a time).
                "minecraft:timer": {
                    "time": 2,
                    "time_down_event": {
                        "event": "extrabiomes:remove_projectile",
                        "target": "self"
                    }
                }
            }
        },
        "components": {
            "minecraft:is_hidden_when_invisible": {},
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player?math.random(1,3):0"
            },
            "minecraft:type_family": {
                "family": ["jellyfish"]
            },
            "minecraft:area_attack": {
                "damage_range": 0.2,
                "damage_per_tick": 2,
                "cause": "contact",
                "entity_filter": {
                    "any_of": [
                        {
                            "test": "is_family",
                            "subject": "other",
                            "value": "player"
                        },
                        {
                            "test": "is_family",
                            "subject": "other",
                            "value": "monster"
                        },
                        {
                            "test": "is_family",
                            "subject": "other",
                            "value": "fish"
                        }
                    ]
                }
            },
            "minecraft:mob_effect": {
                "effect_range": 0.2,
                "mob_effect": "poison",
                "effect_time": 10,
                "entity_filter": {
                    "any_of": [
                        {
                            "test": "is_family",
                            "subject": "other",
                            "value": "player"
                        },
                        {
                            "test": "is_family",
                            "subject": "other",
                            "value": "monster"
                        }
                    ]
                }
            },
            "minecraft:collision_box": {
                "width": 0.8,
                "height": 1
            },
            "minecraft:environment_sensor": {
                "triggers": [
                    {
                        "filters": {
                            "test": "in_water",
                            "subject": "self",
                            "operator": "==",
                            "value": false
                        },
                        "event": "extrabiomes:leave_water"
                    },
                    {
                        "filters": {
                            "test": "in_water",
                            "subject": "self",
                            "operator": "==",
                            "value": true
                        },
                        "event": "extrabiomes:enter_water"
                    }
                ]
            },
            "minecraft:loot": {
                "table": "loot_tables/entities/jellyfish.json"
            },
            "minecraft:scale": {
                "value": 1.2
            },
            "minecraft:health": {
                "value": 6,
                "max": 6
            },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [
                    {
                        "filters": {
                            "test": "in_lava",
                            "subject": "self",
                            "operator": "==",
                            "value": true
                        },
                        "cause": "lava",
                        "damage_per_tick": 4
                    }
                ]
            },
            "minecraft:movement": {
                "value": 0.15
            },
            "minecraft:underwater_movement": {
                "value": 0.15
            },
            "minecraft:navigation.generic": {
                "is_amphibious": false,
                "can_path_over_water": false,
                "can_swim": true,
                "can_walk": false,
                "can_breach": false,
                "can_sink": false
            },
            "minecraft:movement.sway": {
                "sway_amplitude": 0.02
            },
            "minecraft:despawn": {
                "despawn_from_distance": {
                    "min_distance": 32,
                    "max_distance": 40
                }
            },
            "minecraft:behavior.random_swim": {
                "priority": 3,
                "speed_multiplier": 1,
                "xz_dist": 16,
                "y_dist": 4,
                "interval": 0
            },
            "minecraft:behavior.swim_wander": {
                "priority": 5,
                "interval": 1,
                "look_ahead": 2,
                "speed_multiplier": 1,
                "wander_time": 5
            },
            "minecraft:flocking": {
                "in_water": true,
                "match_variants": true,
                "use_center_of_mass": true,
                "low_flock_limit": 4,
                "high_flock_limit": 8,
                "goal_weight": 2,
                "loner_chance": 0.1,
                "influence_radius": 3,
                "breach_influence": 7,
                "separation_weight": 1.75,
                "separation_threshold": 0.95,
                "cohesion_weight": 2,
                "cohesion_threshold": 1.95,
                "innner_cohesion_threshold": 1.25,
                "min_height": 1.5,
                "max_height": 6,
                "block_distance": 2,
                "block_weight": 0.85
            },
            // The interact component (milking + jellyfishing net) lives in the "milk_available"
            // component group instead, so the cooldown can swap it out.
            "minecraft:nameable": {},
            "minecraft:physics": {
                "has_gravity": true
            },
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:conditional_bandwidth_optimization": {}
        },
        "events": {
            "minecraft:entity_spawned": {
                "sequence": [
                    {
                        "add": {
                            "component_groups": ["milk_available"]
                        },
                        "randomize": [
                            {
                                "weight": 3,
                                "add": {
                                    "component_groups": ["jellyfish_pink"]
                                }
                            },
                            {
                                "weight": 1,
                                "add": {
                                    "component_groups": ["jellyfish_purple"]
                                }
                            }
                        ]
                    }
                ]
            },
            "minecraft:entity_born": {
                "sequence": [
                    {
                        "add": {
                            "component_groups": ["projectile", "milk_available"]
                        },
                        "randomize": [
                            {
                                "weight": 3,
                                "add": {
                                    "component_groups": ["jellyfish_pink"]
                                }
                            },
                            {
                                "weight": 1,
                                "add": {
                                    "component_groups": ["jellyfish_purple"]
                                }
                            }
                        ]
                    }
                ]
            },
            "extrabiomes:instant_despawn": {
                "add": {
                    "component_groups": ["instant_despawn"]
                }
            },
            "extrabiomes:begin_milk_cooldown": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": ["milk_available"]
                        }
                    },
                    {
                        "add": {
                            "component_groups": ["milk_cooldown"]
                        }
                    }
                ]
            },
            "extrabiomes:end_milk_cooldown": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": ["milk_cooldown"]
                        }
                    },
                    {
                        "add": {
                            "component_groups": ["milk_available"]
                        }
                    }
                ]
            },
            "extrabiomes:remove_projectile": {
                "remove": {
                    "component_groups": ["projectile"]
                }
            },
            "extrabiomes:leave_water": {
                "add": {
                    "component_groups": ["jellyfish_out_of_water_hitbox"]
                }
            },
            "extrabiomes:enter_water": {
                "remove": {
                    "component_groups": ["jellyfish_out_of_water_hitbox"]
                }
            }
        }
    }
}
