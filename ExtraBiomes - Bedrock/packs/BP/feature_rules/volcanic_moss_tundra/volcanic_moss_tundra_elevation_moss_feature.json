{
  "format_version": "1.14.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "extrabiomes:volcanic_moss_tundra_elevation_moss_feature",
      "places_feature": "extrabiomes:moss/carpet_patch"
    },
    "conditions": {
      "placement_pass": "surface_pass",
      "minecraft:biome_filter": [
        {
          "test": "has_biome_tag",
          "operator": "==",
          "value": "volcanic_moss_tundra"
        }
      ]
    },
    "distribution": {
      "iterations": 60,
      "scatter_chance": "math.clamp((query.heightmap(variable.worldx, variable.worldz) - 79) / 1, 0, 1) * 100",
      "x": {
        "distribution": "uniform",
        "extent": [ 0, 16 ]
      },
      "y": {
        "distribution": "uniform",
        "extent": [ "query.heightmap(variable.worldx, variable.worldz)", "query.heightmap(variable.worldx, variable.worldz)" ]
      },
      "z": {
        "distribution": "uniform",
        "extent": [ 0, 16 ]
      }
    }
  }
}
